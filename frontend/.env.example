VITE_API_BASE_URL=http://localhost:5000
# Local: mantenha a URL acima em .env.local, se necessário.
# Render: cadastre esta variável no Static Site com a URL HTTPS pública da API.
# Use apenas a origem, sem /api, /swagger ou barra final. Refaça o build ao alterar.
# Nunca coloque senhas ou DATABASE_URL em variáveis VITE_.
